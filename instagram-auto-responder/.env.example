# --- Meta / Instagram (required) ---
# Any string you make up; enter the same value in the Meta webhook config.
VERIFY_TOKEN=pick-a-random-string

# Long-lived Instagram access token (Meta app dashboard -> Instagram -> API setup).
IG_ACCESS_TOKEN=

# Meta app secret (App settings -> Basic). Enables webhook signature checks.
APP_SECRET=

# --- Shopify email capture (optional but recommended) ---
# If both are set, captured emails become Shopify customers tagged
# "instagram-follower". If unset, emails append to leads.jsonl instead.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_...

# --- Funnel knobs (optional; defaults in config.js) ---
DISCOUNT_CODE=RABBIT15
SHOP_URL=https://rinkrabbit.com
COMMENT_KEYWORD=DISCOUNT
